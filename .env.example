# Copy to `.env.local` for local development (it's gitignored).

# Production origin, no trailing slash. Used for canonical URLs, OG images and
# the QR code. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional: preview another launch state without editing src/config/site.ts.
# One of prelaunch | preorder | live.
# NEXT_PUBLIC_LAUNCH_STATE=live

# Supabase, for the waitlist. Server-only: the browser posts to /api/waitlist,
# which inserts into public.site_waitlist (supabase/site_waitlist.sql) with the
# publishable ("anon") key. The table's RLS allows insert only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# ── /admin (AD-WEBSITE-ADMIN-PROMPT.md) ─────────────────────────────────────
# Public values, the same as museum-app's VITE_* ones. Never a service-role key.
# Same project as SUPABASE_URL / SUPABASE_ANON_KEY above, but exposed to the
# browser because the admin signs in and calls RPCs from there.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Narsil backend (retry fulfilment, Printful drafts, quiz engine). Read by the
# server only: the admin calls this site's /api/admin/*, which relays to the
# backend, so the backend's CORS_ORIGIN doesn't need this site. Defaults to the
# production backend; set http://localhost:4000 to use a local one.
NEXT_PUBLIC_API_URL=https://d2lvgalchu2nps.cloudfront.net
# Member web app: password-reset links land here, not on the ad site.
NEXT_PUBLIC_APP_WEB_URL=https://narsil-app-frontend.vercel.app

# Where `npm run admin:sync` / `admin:check` read the app's lib/ from.
# MUSEUM_APP_DIR=E:/Project-dev/museum-app
