# Copy to `.env.local` for local development (it's gitignored).

# Production origin, no trailing slash. Used for canonical URLs, OG images and
# the QR code. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional: preview another launch state without editing src/config/site.ts.
# One of prelaunch | preorder | live.
# NEXT_PUBLIC_LAUNCH_STATE=live

# Supabase, for the waitlist. Server-only: the browser posts to /api/waitlist,
# which inserts into public.site_waitlist (supabase/site_waitlist.sql) with the
# publishable ("anon") key. The table's RLS allows insert only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
